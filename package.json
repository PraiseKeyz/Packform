{
  "name": "packform",
  "version": "0.1.1",
  "description": "Turn packaging dielines (.ai / .pdf) into true-size, textured 3D models (.glb): cartons that fold themselves up, bottles, jars, cans, cups, blister packs, sachets and pouches. CLI, Node.js API and React viewer.",
  "keywords": [
    "dieline",
    "packaging",
    "packaging-design",
    "3d",
    "3d-model",
    "glb",
    "gltf",
    "carton",
    "box",
    "folding-carton",
    "label",
    "bottle",
    "blister",
    "sachet",
    "pouch",
    "mockup",
    "pdf",
    "illustrator",
    "three",
    "react",
    "react-three-fiber",
    "cli"
  ],
  "author": "Praise Adebayo",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "packform": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@napi-rs/canvas": "^0.1.100",
    "earcut": "^3.2.4",
    "pdfjs-dist": "^5.7.284",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@react-three/drei": ">=9",
    "@react-three/fiber": ">=8",
    "react": ">=18",
    "three": ">=0.150"
  },
  "peerDependenciesMeta": {
    "@react-three/drei": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
